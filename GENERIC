from typing import TypeVar, Generic, List

# Define a TypeVar T for generic type annotations
T = TypeVar("T")

class Inventory(Generic[T]):
    """
    A generic inventory class that supports storing, retrieving, 
    and managing single items or multiple items of uniform data type.
    """
    def init(self, item: T = None) -> None:
        self._item: T = item
        self._items_list: List[T] = []
        if item is not None:
            self._items_list.append(item)

    def store(self, item: T) -> None:
        """Stores a single item."""
        self._item = item
        self._items_list.append(item)

    def retrieve(self) -> T:
        """Retrieves the most recently stored single item."""
        return self._item

    def display_info(self) -> None:
        """Displays the type and value of the single stored item."""
        print(f"Item Value : {self._item}")
        print(f"Data Type  : {type(self._item).name}")

    # Extended Functionality: Maintaining multiple items while preserving type consistency
    def add_item(self, item: T) -> None:
        """Adds an item to the generic collection while preserving type integrity."""
        self._items_list.append(item)

    def get_all_items(self) -> List[T]:
        """Retrieves all stored items in the collection."""
        return self._items_list

    def display_all(self) -> None:
        """Displays all items and their collective data type."""
        print(f"Collection Values : {self._items_list}")
        if self._items_list:
            print(f"Elements Data Type: {type(self._items_list[0]).name}")


